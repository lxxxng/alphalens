# PostgreSQL container and application connection
POSTGRES_USER=alphalens
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=alphalens
DATABASE_URL=postgresql+psycopg2://alphalens:CHANGE_ME@localhost:5432/alphalens

SEC_USER_AGENT=AlphaLens your-email@example.com

# Official EarningsCalls.dev full-transcript API
EARNINGSCALLS_API_KEY=YOUR_EARNINGSCALLS_API_KEY
EARNINGSCALLS_REQUEST_SECONDS=3.1
TRANSCRIPT_LOOKBACK_YEARS=5

# Legacy Alpha Vantage transcript extractor
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY
TRANSCRIPT_REQUEST_SECONDS=12

# Optional: EarningsCalls.dev free-tier metadata checks via RapidAPI
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY

# Used later for embeddings / RAG
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

RAG_MODEL=gpt-5-mini

# Optional independent model for end-to-end response evaluations.
# Defaults to RAG_MODEL when omitted.
EVAL_JUDGE_MODEL=gpt-5-mini
